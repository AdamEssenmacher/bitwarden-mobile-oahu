<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Bit.App.Pages.GeneratorPage"
    xmlns:pages="clr-namespace:Bit.App.Pages"
    xmlns:controls="clr-namespace:Bit.App.Controls"
    xmlns:u="clr-namespace:Bit.App.Utilities"
    xmlns:effects="clr-namespace:Bit.App.Effects"
    xmlns:core="clr-namespace:Bit.Core"
    xmlns:enums="clr-namespace:Bit.Core.Enums"
    xmlns:oahu="clr-namespace:Oahu.Maui;assembly=Oahu.Maui"
    xmlns:contracts="clr-namespace:Bit.App.Contracts;assembly=Core.Contracts"
    HideSoftInputOnTapped="True"
    x:DataType="pages:GeneratorPageViewModel"
    Title="{Binding PageTitle}">
    <ContentPage.BindingContext>
        <pages:GeneratorPageViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <ToolbarItem Text="{u:I18n Cancel}" Command="{Binding CloseCommand}" Order="Primary" Priority="-1"
                         x:Name="_closeItem" x:Key="closeItem" />
            <ToolbarItem Text="{u:I18n Select}"
                     Clicked="Select_Clicked"
                     Order="Primary"
                     x:Name="_selectItem"
                     x:Key="selectItem" />
            <ToolbarItem Text="{u:I18n PasswordHistory}"
                     Clicked="History_Clicked"
                     Order="Secondary"
                     x:Name="_historyItem"
                     x:Key="historyItem" />
            <ToolbarItem IconImageSource="more_vert.png"
                         SemanticProperties.Description="{u:I18n Options}"
                         Clicked="More_Clicked"
                         x:Name="_moreItem"
                         x:Key="moreItem" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- OAHU: the whole form (value, copy/regenerate, type pickers, password, passphrase and username options) is a
         native screen (GeneratorScreen in SwiftUI and Compose) bound to this view model through IGeneratorViewModel.
         The page keeps its title, toolbar items (Cancel/Select in the modal, history or options on the tab) and
         dialogs. docs/oahu/04-generator-lock.md -->
    <oahu:OahuView x:Name="_generatorView"
                   x:TypeArguments="contracts:IGeneratorViewModel"
                   ViewModel="{Binding .}" />
</pages:BaseContentPage>
