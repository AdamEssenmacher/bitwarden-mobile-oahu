@@ -0,0 +1,84 @@
+import Darwin
+import XCTest
+
+/// Issue 977 harness, second host: drives the Bitwarden MAUI app's DEBUG add-note route (com.8bit.bitwarden, built
+/// from the fork's oahu/06-keystroke-repro branch and installed on the same simulator). Same typing modes as
+/// Repro977UITests; variants are BW_OAHU_NOTES_MODE values (state, model, local, single). Prints one
+/// `REPRO977 RESULT` line per run with the field's final accessibility value; the app's own logs hold the rest.
+/// Configured by REPRO_ROUNDS, REPRO_VARIANTS, REPRO_MODES, REPRO_TAG, REPRO_TEXT (TEST_RUNNER_ prefix).
+@MainActor
+final class Repro977BitwardenUITests: XCTestCase {
+    private func load() -> String {
+        var values = [Double](repeating: 0, count: 3)
+        guard getloadavg(&values, 3) == 3 else { return "?" }
+        return String(format: "%.2f", values[0])
+    }
+
+    func testRepro977Bitwarden() {
+        let env = ProcessInfo.processInfo.environment
+        let rounds = Int(env["REPRO_ROUNDS"] ?? "1") ?? 1
+        let variants = (env["REPRO_VARIANTS"] ?? "state,model,local,single").split(separator: ",").map(String.init)
+        let modes = (env["REPRO_MODES"] ?? "xcui0").split(separator: ",").map(String.init)
+        let tag = env["REPRO_TAG"] ?? "bw"
+        let text = env["REPRO_TEXT"] ?? "The quick brown fox jumps over"
+        continueAfterFailure = true
+        for round in 0..<rounds {
+            let shift = round % variants.count
+            for variant in Array(variants[shift...] + variants[..<shift]) {
+                for mode in modes {
+                    runOne(tag: tag, round: round, variant: variant, mode: mode, text: text)
+                }
+            }
+        }
+    }
+
+    private func runOne(tag: String, round: Int, variant: String, mode: String, text: String) {
+        let runId = "\(tag)-r\(round)-\(variant)-\(mode)"
+        let load0 = load()
+        let app = XCUIApplication(bundleIdentifier: "com.8bit.bitwarden")
+        app.launchEnvironment = [
+            "BW_OAHU_DEBUG": "edit", "BW_OAHU_EDIT": "add-note", "BW_OAHU_NOTES_MODE": variant,
+            "BW_OAHU_REPRO_RUN": runId, "BW_OAHU_REPRO_MODE": mode, "BW_OAHU_REPRO_TEXT": text,
+        ]
+        app.launch()
+        let field = app.descendants(matching: .any).matching(identifier: "ItemNotesEntry").firstMatch
+        guard field.waitForExistence(timeout: 90) else {
+            print("REPRO977 RESULT run=\(runId) status=nofield load0=\(load0) load1=\(load())")
+            app.terminate()
+            return
+        }
+        let started = Date()
+        field.tap()
+        switch mode {
+        case "xcui0":
+            field.typeText(text)
+        case "xcui1":
+            Thread.sleep(forTimeInterval: 1.0)
+            field.typeText(text)
+        default:
+            break  // inject: the app types
+        }
+        // Wait until the field's value stops changing for 2 s (at most 60 s): the host can draw seconds late.
+        var last = ""
+        var stableSince = Date()
+        let deadline = Date().addingTimeInterval(60)
+        while Date() < deadline {
+            let value = (field.value as? String) ?? ""
+            if value != last {
+                last = value
+                stableSince = Date()
+            } else if Date().timeIntervalSince(stableSince) > 2, !value.isEmpty {
+                break
+            }
+            Thread.sleep(forTimeInterval: 0.25)
+        }
+        let seconds = Date().timeIntervalSince(started)
+        // Let the app's logs flush (one second after the last entry).
+        Thread.sleep(forTimeInterval: 1.5)
+        print(
+            "REPRO977 RESULT run=\(runId) tag=\(tag) round=\(round) variant=\(variant) mode=\(mode) load0=\(load0) "
+                + "load1=\(load()) seconds=\(String(format: "%.1f", seconds)) "
+                + "field=\(last.replacingOccurrences(of: "\n", with: "\\n"))|model=?")
+        app.terminate()
+    }
+}
diff --git a/tests/native/apple/EditableLab/EditableLabUITests/Repro977UITests.swift b/tests/native/apple/EditableLab/EditableLabUITests/Repro977UITests.swift
