diff --git a/tests/native/apple/EditableLab/EditableLab/Repro977Screen.swift b/tests/native/apple/EditableLab/EditableLab/Repro977Screen.swift
new file mode 100644
index 00000000..57172426
--- /dev/null
+++ b/tests/native/apple/EditableLab/EditableLab/Repro977Screen.swift
@@ -0,0 +1,220 @@
+import EverythingScreens
+import Observation
+import QuartzCore
+import SwiftUI
+import UIKit
+
+// Issue 977 reproduction harness (not part of OAHU's checks). One text field per launch, chosen by `-variant`:
+//   A  plain SwiftUI @State, multi-line (no OAHU)
+//   O  plain @Observable class, multi-line (no OAHU)
+//   B  generated $model.title, multi-line, view model accepts as typed
+//   C  generated $model.title, single-line, accepts
+//   D  generated $model.title, multi-line, view model upper-cases (the hold engages on every edit)
+//   S  generated $model.title, multi-line, accepts after a 30 ms main-thread stall per edit (a slow view model)
+//   L  positive control: generated $model.title, multi-line, accepts, then re-publishes each proposal 30 ms later
+// Every layer logs into Repro977Log with a sequence number and a time: "key" (a character the app itself injects),
+// "edit" (a proposal reaching the view model, i.e. the binding setter), "answer" (what the view model publishes back),
+// "uiChange" (UIKit's text-did-change notification) and "ui" (the field's UIKit text, sampled every frame, logged when
+// it changes, so programmatic rewrites show up too). "Read" writes the log to Documents/repro977/<runId>.jsonl.
+
+@MainActor
+final class Repro977Log {
+    static let shared = Repro977Log()
+    private let t0 = CACurrentMediaTime()
+    private var seq = 0
+    private(set) var lines: [String] = []
+
+    func log(_ kind: String, _ text: String) {
+        seq += 1
+        let ms = (CACurrentMediaTime() - t0) * 1000
+        let escaped = text.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: "\"", with: "\\\"")
+            .replacingOccurrences(of: "\n", with: "\\n")
+        lines.append(String(format: "{\"seq\":%d,\"ms\":%.1f,\"kind\":\"%@\",\"text\":\"%@\"}", seq, ms, kind, escaped))
+    }
+
+    func write(runId: String, summary: String) {
+        log("summary", summary)
+        let fm = FileManager.default
+        guard let docs = fm.urls(for: .documentDirectory, in: .userDomainMask).first else { return }
+        let dir = docs.appendingPathComponent("repro977", isDirectory: true)
+        try? fm.createDirectory(at: dir, withIntermediateDirectories: true)
+        let url = dir.appendingPathComponent("\(runId).jsonl")
+        try? (lines.joined(separator: "\n") + "\n").write(to: url, atomically: true, encoding: .utf8)
+    }
+}
+
+@Observable
+@MainActor
+final class Repro977Plain {
+    var text = "" {
+        didSet { Repro977Log.shared.log("edit", text) }
+    }
+}
+
+struct Repro977Config {
+    let variant: String
+    let mode: String
+    let runId: String
+    let text: String
+
+    static func from(_ arguments: [String]) -> Repro977Config {
+        func value(_ name: String, _ fallback: String) -> String {
+            guard let i = arguments.firstIndex(of: name), i + 1 < arguments.count else { return fallback }
+            return arguments[i + 1]
+        }
+        return Repro977Config(
+            variant: value("-variant", "B"), mode: value("-mode", "xcui0"), runId: value("-runId", "manual"),
+            text: value("-text", "The quick brown fox jumps over"))
+    }
+
+    var usesOahu: Bool { ["B", "C", "D", "S", "L"].contains(variant) }
+
+    @MainActor
+    func makeModel() -> EverythingModel {
+        let variant = variant
+        return EverythingModel.preview(
+            screen: nil, counter: 0,
+            title: "", titleError: nil, notify: false, volume: 0.5, guests: 2, size: .small, theme: nil,
+            startsAt: Date(timeIntervalSince1970: 1_800_000_000), selectedKey: nil, selected: [],
+            window: Window(start: Date(timeIntervalSince1970: 1_800_000_000), length: .seconds(3600))
+        ) { preview in
+            preview.onEditTitle { proposed in
+                Repro977Log.shared.log("edit", proposed)
+                var answer = proposed
+                if variant == "D" { answer = proposed.uppercased() }
+                if variant == "S" { Thread.sleep(forTimeInterval: 0.03) }
+                if variant == "L" {
+                    // Positive control: a view model that re-publishes each proposal 30 ms later, by then stale.
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.03) {
+                        Repro977Log.shared.log("lateEcho", proposed)
+                        preview.setTitle(proposed)
+                    }
+                }
+                Repro977Log.shared.log("answer", answer)
+                return answer
+            }
+        }
+    }
+}
+
+struct Repro977Screen: View {
+    let config: Repro977Config
+    @Bindable var model: EverythingModel
+    @State private var plain = Repro977Plain()
+    @State private var local = ""
+    @State private var result = ""
+    @State private var injected = "no"
+    @State private var sampler: Repro977Sampler?
+
+    var body: some View {
+        VStack(spacing: 16) {
+            field
+                .accessibilityIdentifier("probe.field")
+            Button("Read") { read() }
+                .accessibilityIdentifier("probe.read")
+            Text(verbatim: injected).accessibilityIdentifier("probe.injected")
+            Text(verbatim: result).accessibilityIdentifier("probe.result")
+            Spacer()
+        }
+        .padding()
+        .onAppear {
+            Repro977Log.shared.log("start", "\(config.variant) \(config.mode) \(config.runId)")
+            let sampler = Repro977Sampler(config: config) { injected = $0 }
+            sampler.start()
+            self.sampler = sampler
+        }
+    }
+
+    @ViewBuilder private var field: some View {
+        switch config.variant {
+        case "A":
+            TextField("Title", text: $local, axis: .vertical)
+                .onChange(of: local) { _, new in Repro977Log.shared.log("edit", new) }
+        case "O":
+            TextField("Title", text: $plain.text, axis: .vertical)
+        case "C":
+            TextField("Title", text: $model.title)
+        default:
+            TextField("Title", text: $model.title, axis: .vertical)
+        }
+    }
+
+    private func read() {
+        let fieldText: String
+        if let input = FirstResponder.find() as? UITextInput,
+            let all = input.textRange(from: input.beginningOfDocument, to: input.endOfDocument)
+        {
+            fieldText = input.text(in: all) ?? ""
+        } else {
+            fieldText = "<no focused field>"
+        }
+        let modelText: String
+        switch config.variant {
+        case "A": modelText = local
+        case "O": modelText = plain.text
+        default: modelText = model.titleTextInput
+        }
+        let summary = "field=\(fieldText)|model=\(modelText)"
+        Repro977Log.shared.write(runId: config.runId, summary: summary)
+        result = summary
+    }
+}
+
+/// Samples the focused field's UIKit text every frame and, in "inject" mode, types the text itself once a field is
+/// focused: one `insertText` every 50 ms (20 characters a second), starting on the frame focus is seen.
+@MainActor
+final class Repro977Sampler: NSObject {
+    private let config: Repro977Config
+    private let report: (String) -> Void
+    private var link: CADisplayLink?
+    private var last: String?
+    private var injecting = false
+
+    init(config: Repro977Config, report: @escaping (String) -> Void) {
+        self.config = config
+        self.report = report
+    }
+
+    func start() {
+        let link = CADisplayLink(target: self, selector: #selector(tick))
+        link.add(to: .main, forMode: .common)
+        self.link = link
+        for name in [UITextField.textDidChangeNotification, UITextView.textDidChangeNotification] {
+            NotificationCenter.default.addObserver(self, selector: #selector(changed(_:)), name: name, object: nil)
+        }
+    }
+
+    @objc private func changed(_ note: Notification) {
+        let text = (note.object as? UITextField)?.text ?? (note.object as? UITextView)?.text ?? "?"
+        Repro977Log.shared.log("uiChange", text)
+    }
+
+    @objc private func tick() {
+        guard let input = FirstResponder.find() as? UITextInput,
+            let all = input.textRange(from: input.beginningOfDocument, to: input.endOfDocument)
+        else { return }
+        let text = input.text(in: all) ?? ""
+        if text != last {
+            if last == nil { Repro977Log.shared.log("focus", text) }
+            last = text
+            Repro977Log.shared.log("ui", text)
+        }
+        if config.mode == "inject" && !injecting {
+            injecting = true
+            inject(into: input)
+        }
+    }
+
+    private func inject(into input: UITextInput) {
+        let characters = Array(config.text)
+        let report = report
+        Task { @MainActor in
+            for character in characters {
+                Repro977Log.shared.log("key", String(character))
+                input.insertText(String(character))
+                try? await Task.sleep(for: .milliseconds(50))
+            }
+            report("done")
+        }
+    }
+}
diff --git a/tests/native/apple/EditableLab/EditableLabUITests/Repro977BitwardenUITests.swift b/tests/native/apple/EditableLab/EditableLabUITests/Repro977BitwardenUITests.swift
