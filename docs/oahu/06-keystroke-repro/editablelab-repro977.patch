+++ b/tests/native/apple/EditableLab/EditableLabUITests/Repro977UITests.swift
@@ -0,0 +1,79 @@
+import Darwin
+import XCTest
+
+/// Issue 977 harness: launches the lab's repro screen once per run, focuses the field with a real tap and types a fixed
+/// string, then reads back the field's UIKit text and the model's value. It never fails on a lost character: it prints
+/// one `REPRO977 RESULT` line per run (with the host load average before and after) for the host script to count.
+/// Configured by environment (pass with the TEST_RUNNER_ prefix to xcodebuild): REPRO_ROUNDS, REPRO_VARIANTS,
+/// REPRO_MODES, REPRO_TAG, REPRO_TEXT. Modes: xcui0 (typeText right after the tap), xcui1 (tap, 1 s pause, typeText),
+/// xcuichar (tap, then one typeText per character, no added gap), inject (the app types 20 characters a second).
+@MainActor
+final class Repro977UITests: XCTestCase {
+    private func load() -> String {
+        var values = [Double](repeating: 0, count: 3)
+        guard getloadavg(&values, 3) == 3 else { return "?" }
+        return String(format: "%.2f", values[0])
+    }
+
+    func testRepro977() {
+        let env = ProcessInfo.processInfo.environment
+        let rounds = Int(env["REPRO_ROUNDS"] ?? "1") ?? 1
+        let variants = (env["REPRO_VARIANTS"] ?? "A,O,B,C,D,S").split(separator: ",").map(String.init)
+        let modes = (env["REPRO_MODES"] ?? "xcui0,inject").split(separator: ",").map(String.init)
+        let tag = env["REPRO_TAG"] ?? "set"
+        let text = env["REPRO_TEXT"] ?? "The quick brown fox jumps over"
+        continueAfterFailure = true
+        for round in 0..<rounds {
+            // Interleave: rotate the variant order each round so no variant always runs first or last.
+            let shift = round % variants.count
+            let order = Array(variants[shift...] + variants[..<shift])
+            for variant in order {
+                for mode in modes {
+                    runOne(tag: tag, round: round, variant: variant, mode: mode, text: text)
+                }
+            }
+        }
+    }
+
+    private func runOne(tag: String, round: Int, variant: String, mode: String, text: String) {
+        let runId = "\(tag)-r\(round)-\(variant)-\(mode)"
+        let load0 = load()
+        let started = Date()
+        let app = XCUIApplication()
+        app.launchArguments = ["-repro977", "-variant", variant, "-mode", mode, "-runId", runId, "-text", text]
+        app.launch()
+        let field = app.descendants(matching: .any).matching(identifier: "probe.field").firstMatch
+        guard field.waitForExistence(timeout: 30) else {
+            print("REPRO977 RESULT run=\(runId) status=nofield load0=\(load0) load1=\(load())")
+            app.terminate()
+            return
+        }
+        field.tap()
+        switch mode {
+        case "xcui0":
+            field.typeText(text)
+        case "xcui1":
+            Thread.sleep(forTimeInterval: 1.0)
+            field.typeText(text)
+        case "xcuichar":
+            for character in text { field.typeText(String(character)) }
+        default:
+            let injected = app.staticTexts["probe.injected"]
+            let done = NSPredicate(format: "label == %@", "done")
+            let expectation = XCTNSPredicateExpectation(predicate: done, object: injected)
+            _ = XCTWaiter().wait(for: [expectation], timeout: 60)
+        }
+        let typedSeconds = Date().timeIntervalSince(started)
+        // Let any hold release (50 ms) and late redraw settle before reading.
+        Thread.sleep(forTimeInterval: 1.5)
+        app.buttons["probe.read"].tap()
+        let result = app.staticTexts["probe.result"]
+        let ready = NSPredicate(format: "label BEGINSWITH %@", "field=")
+        _ = XCTWaiter().wait(for: [XCTNSPredicateExpectation(predicate: ready, object: result)], timeout: 30)
+        let summary = result.label.replacingOccurrences(of: "\n", with: "\\n")
+        print(
+            "REPRO977 RESULT run=\(runId) tag=\(tag) round=\(round) variant=\(variant) mode=\(mode) load0=\(load0) "
+                + "load1=\(load()) seconds=\(String(format: "%.1f", typedSeconds)) \(summary)")
+        app.terminate()
+    }
+}
